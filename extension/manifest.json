{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "小红书舆情监控助手",
  "version": "0.14.0",
  "description": "为当前小红书页面的帖子提供同页详情拉取、Process 进度面板、卡片框选与可选悬浮窗，把正文、图片和评论幂等写入本地 Excel 与 SQLite。",
  "permissions": [
    "storage",
    "nativeMessaging",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "舆情监控助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": [
        "relevance.js",
        "page-context.js",
        "note-utils.js",
        "detail-store.js",
        "comment-utils.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
