{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "小红书舆情监控助手",
  "version": "0.34.19",
  "description": "为小红书帖子提供同页核对、Process 进度、图片/视频/评论完整采集，并幂等写入本地 UTF-8 CSV / SQLite。",
  "permissions": [
    "storage",
    "nativeMessaging",
    "sidePanel",
    "windows",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "舆情监控助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": [
        "relevance.js",
        "page-context.js",
        "note-utils.js",
        "detail-store.js",
        "location-utils.js",
        "comment-utils.js",
        "comment-collector.js",
        "process-layout.js",
        "comment-locator.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": [
        "comment-locator-mode.js"
      ],
      "run_at": "document_start"
    }
  ]
}
